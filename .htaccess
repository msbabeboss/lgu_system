# ============================================================
#  LGU System — Root .htaccess
#  Security hardening for XAMPP + Tailscale Funnel deployment
# ============================================================

# ── 1. Block direct access to sensitive files ────────────────
<FilesMatch "^(\.env|composer\.(json|lock|phar)|.*\.sql|.*\.md|.*\.log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── 2. Block access to hidden dot-files/folders ─────────────
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── 2b. Block .git directory (FilesMatch doesn't cover dirs) ─
RedirectMatch 404 /\.git

# ── 3. Block directory listing ───────────────────────────────
Options -Indexes

# ── 4. Block access to sensitive directories ─────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to config/, helpers/, database/, vendor/, python/, _csrf_reference/
    RewriteRule ^(config|helpers|database|vendor|python|_csrf_reference|\.agents|\.qodo|\.vscode)(/|$) - [F,L]
</IfModule>

# ── 5. Security headers ──────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # XSS protection (legacy browsers)
    Header always set X-XSS-Protection "1; mode=block"

    # Only send referrer on same-origin requests
    Header always set Referrer-Policy "same-origin"

    # ── HSTS — only sent over HTTPS connections ──────────────
    # max-age=31536000 = 1 year; includeSubDomains covers the .ts.net Tailscale host.
    # Do NOT add preload until the domain is registered with the HSTS preload list.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # ── Content-Security-Policy ──────────────────────────────
    # Allows:
    #   default-src 'self'                — everything same-origin unless overridden
    #   script-src  CDNs + 'unsafe-inline'— Bootstrap, Chart.js, jQuery, Select2,
    #                                       Pusher, SheetJS, html2pdf + inline <script>
    #   style-src   CDNs + 'unsafe-inline'— Bootstrap Icons, Font Awesome,
    #                                       Google Fonts + inline <style>
    #   font-src    CDNs + data:           — Bootstrap Icons (woff2), Font Awesome,
    #                                       Google Fonts (gstatic), data: URIs
    #   img-src     'self' data: blob:     — local images, base64 resident photos,
    #                                       Chart.js canvas exports, html2pdf blobs
    #   connect-src 'self' wss://ws-*.pusher.com
    #                                     — AJAX same-origin + Pusher WebSocket
    #   frame-ancestors 'self'            — replaces X-Frame-Options (modern browsers)
    #   object-src  'none'                — block Flash / plugins
    #   base-uri    'self'                — prevent base-tag hijacking
    #   form-action 'self'                — forms only submit to same origin
    Header always set Content-Security-Policy "\
default-src 'self'; \
script-src 'self' 'unsafe-inline' \
  https://cdn.jsdelivr.net \
  https://cdnjs.cloudflare.com \
  https://js.pusher.com \
  https://cdn.sheetjs.com \
  blob:; \
style-src 'self' 'unsafe-inline' \
  https://cdn.jsdelivr.net \
  https://cdnjs.cloudflare.com \
  https://fonts.googleapis.com; \
font-src 'self' data: \
  https://cdn.jsdelivr.net \
  https://cdnjs.cloudflare.com \
  https://fonts.gstatic.com; \
img-src 'self' data: blob: \
  https://cdn.jsdelivr.net; \
connect-src 'self' \
  wss://ws-mt1.pusher.com \
  wss://ws-ap1.pusher.com \
  wss://ws-ap2.pusher.com \
  wss://ws-ap3.pusher.com \
  wss://ws-ap4.pusher.com \
  wss://ws-eu.pusher.com \
  https://sockjs-mt1.pusher.com \
  https://sockjs-ap1.pusher.com; \
frame-ancestors 'self'; \
object-src 'none'; \
base-uri 'self'; \
form-action 'self';"

    # Remove server version info
    Header unset Server
    Header unset X-Powered-By
</IfModule>

# ── 6. PHP error display off (never show errors to browser) ──
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
